{
  "name": "circuitkit",
  "version": "0.1.0",
  "private": true,
  "description": "Typed circuit diagrams, linked node annotations and portable SVG for authors and agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/crafter-lab/circuitkit.git"
  },
  "bugs": "https://github.com/crafter-lab/circuitkit/issues",
  "homepage": "https://circuitkit.vercel.app",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "bin": {
    "circuitkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "examples/*.json",
    "skills",
    "docs/guide.md",
    "docs/cli-contract.md",
    "docs/complex-circuits.md",
    "docs/stress-corpus.md",
    "docs/testing.md",
    "docs/landing-design.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build:web": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "check": "biome check ."
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "opentype.js": "2.0.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
